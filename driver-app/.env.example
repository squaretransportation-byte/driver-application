# Square Transportation — driver application
# Copy to .env.local for development. In production these live in Vercel project
# environment variables. Never commit real values.

# ---- Firebase Admin ----------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ---- PII field encryption ----------------------------------------------------
# REQUIRED. Without it, /api/submit refuses any submission containing an SSN rather
# than storing it in plaintext.
#
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# This key MUST NOT live in the Firebase project or in the same service account that
# reads Firestore. Key separation is what preserves the 815 ILCS 530 safe harbour:
# PIPA's definition of "personal information" reaches only unencrypted data, so
# ciphertext stored beside its own key is treated as plaintext.
PII_ENCRYPTION_KEY=

# Set during key rotation only. decryptField() tries the current key, then this one.
PII_ENCRYPTION_KEY_PREVIOUS=

# ---- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- RingCentral -------------------------------------------------------------
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_FROM_NUMBER=
# Comma-separated recipients for new-application alerts.
RINGCENTRAL_DISPATCH_NUMBERS=

# ---- SquareSchedule sync -----------------------------------------------------
# Where completed applications are pushed so they appear in the recruiting queue
# at /recruiting. Without both of these, applications are stored here only and
# never reach SquareSchedule — which is the bug this pair fixes.
#
# INGEST_SECRET must be IDENTICAL to the value set on the SquareSchedule
# deployment; it authenticates api/ingest-application.js there.
SQUARESCHEDULE_URL=https://squareschedule.net
INGEST_SECRET=

# ---- Request guards ----------------------------------------------------------
# Comma-separated origins permitted to POST to /api/*. Defaults to the production
# hostnames if unset; preview deployments and localhost are allowed automatically
# when VERCEL_ENV is not "production".
ALLOWED_ORIGINS=https://apply.gosquare.net,https://gosquare.net
